DATABASE_URL=postgresql://bookmart@127.0.0.1:5432/bookmart_gamexchange
SESSION_SECRET=
APP_URL=http://localhost:8080

# Private launch mode: set to preview on the host and add a strong secret below.
# Switch SITE_ACCESS_MODE to live when Nathan approves the public launch.
SITE_ACCESS_MODE=live
SITE_PREVIEW_PASSWORD=

# Intake
BARCODE_INTAKE_ENABLED=true
METADATA_PROVIDER_PRIORITY=openlibrary,demo
AI_PHOTO_IDENTIFICATION_ENABLED=false
# Provider: gemini (default) or openai. Server-side only — keys never reach the browser.
AI_PHOTO_IDENTIFICATION_PROVIDER=gemini
# Google AI Studio key (free). Identifies rare/unbarcoded items from photos via Gemini.
GEMINI_API_KEY=
# OpenAI API key. Used for photo identification when AI_PHOTO_IDENTIFICATION_PROVIDER=openai.
# The public website can NEVER extract this key — it lives in server env vars only.
OPENAI_API_KEY=

# Stripe remains disabled until live credentials are supplied.
STRIPE_ENABLED=false
STRIPE_TEST_ADAPTER=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=

# Owner setup is performed with `npm run owner:setup -- --name ...`.
# Never commit a real password or PIN.
