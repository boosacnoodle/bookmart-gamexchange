DATABASE_URL=postgresql://bookmart@127.0.0.1:5432/bookmart_gamexchange
SESSION_SECRET=
APP_URL=http://localhost:8080

# Intake
BARCODE_INTAKE_ENABLED=true
METADATA_PROVIDER_PRIORITY=openlibrary,demo
AI_PHOTO_IDENTIFICATION_ENABLED=false
OPENAI_API_KEY=

# Stripe remains disabled until live credentials are supplied.
STRIPE_ENABLED=false
STRIPE_TEST_ADAPTER=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=

# Owner setup is performed with `npm run owner:setup -- --name ...`.
# Never commit a real password or PIN.
